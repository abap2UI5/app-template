{
  "name": "abap2ui5-app",
  "private": true,
  "version": "1.0.0",
  "description": "abap2UI5 app project - the gates that check it without an SAP system.",
  "scripts": {
    "check": "npm run check:abap && npm run check:abap2ui5",
    "check:abap": "abaplint abaplint.jsonc",
    "check:abap2ui5": "abap2ui5lint",
    "check:abap2ui5:fast": "abap2ui5lint --no-render",
    "check:all": "npm run check:pin && npm run check",
    "check:pin": "node scripts/check-pin.mjs",
    "fix": "abap2ui5lint --fix",
    "test": "npm run check:all"
  },
  "license": "MIT",
  "devDependencies": {
    "@abap2ui5/linter": "^0.5.1",
    "@abap2ui5/render-runtime": "^0.5.1",
    "@abaplint/cli": "^2.120.38"
  },
  "engines": {
    "node": ">=22"
  }
}
