{
  // abap2UI5-linter settings for this repo (CLI flag > this file > defaults)
  // docs: https://github.com/abap2UI5/linter#configuration-file--abap2ui5lintjsonc
  "$schema": "https://raw.githubusercontent.com/abap2UI5/linter/main/data/abap2ui5lint.schema.json",
  "paths": ["src"],
  "ui5": "1.71",             // raise this to the UI5 version your system runs
  "distribution": "sapui5",  // "openui5" reports SAPUI5-only controls too
  "failOn": "warning"

  // More knobs — the $schema above gives editor completion for all of them:
  // "allow": ["sap.m.Avatar.displaySize"],   // accept members despite the UI5 floor
  // "rules": {
  //   "member-too-new": "hint",              // per rule: false | severity | { severity, exclude }
  //   "missing-accessibility": false
  // }
}
